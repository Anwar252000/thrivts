{
  "name": "vintage-hub-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:staff": "vite --config apps/staff/vite.config.ts",
    "dev:owner": "vite --config apps/owner/vite.config.ts",
    "build:staff": "tsc -p apps/staff && vite build --config apps/staff/vite.config.ts",
    "build:owner": "tsc -p apps/owner && vite build --config apps/owner/vite.config.ts",
    "build": "npm run build:staff && npm run build:owner",
    "typecheck": "tsc -p apps/staff && tsc -p apps/owner && tsc -p tsconfig.node.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
